  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "npx wrangler pages dev public --port 8787",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "test:node-preview-scroll": "node tests/browser/node-preview-scroll.mjs",
    "test:modal-loading": "node tests/browser/modal-loading.mjs",
    "test:browser-storage": "node tests/browser/browser-storage-resilience.mjs",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "format": "prettier --write \"functions/**/*.js\" \"src/**/*.{js,vue}\" \"tests/**/*.js\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"functions/**/*.js\" \"src/**/*.{js,vue}\" \"tests/**/*.js\" \"docs/**/*.md\""
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "js-yaml": "^4.3.2",
    "pinia": "^3.0.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "~2.4.6",
    "happy-dom": "^21.0.4",
    "jsdom": "^28.1.0",
    "miniflare": "^4.20260730.0",
    "playwright": "^1.60.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.12",
    "terser": "^5.48.0",
    "vite": "^7.3.8",
    "vitest": "^4.1.12",
    "wrangler": "~4.116.0"
  },
  "overrides": {
    "editorconfig": {
      "minimatch": "^11.0.8"
    },
    "js-beautify": {
      "glob": "^14.0.6"
    },
    "miniflare": {
      "sharp": "^0.35.5",
      "undici": "^7.30.2"
    }
  }
